# ─── Server ───
PORT=3000
NODE_ENV=development

# ─── PostgreSQL ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flash_sale
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=5
DB_POOL_MAX=50

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── RabbitMQ ───
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── JWT ───
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=24h

# ─── Flash Sale Config ───
SALE_PRODUCT_ID=phone_500
SALE_TOTAL_STOCK=500
SALE_START_TIME=2025-01-15T20:00:00.000Z
SALE_RESERVATION_TTL_SECONDS=300
SALE_MAX_PER_USER=1

# ─── Worker Config ───
WORKER_CONCURRENCY=10
WORKER_PREFETCH=5
RECONCILER_INTERVAL_MS=20000

# ─── Cloudflare Turnstile Bot Protection ───
# Official Cloudflare test keys (always pass in dev/testing):
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000AA
TURNSTILE_ENABLED=false
